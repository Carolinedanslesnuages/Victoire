{
  "expo": {
    "name": "PACE",
    "slug": "pace",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carolinedanslesnuages.pace",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "This app does not track you. We respect your privacy and do not collect any tracking data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.carolinedanslesnuages.pace",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "privacyPolicyUrl": "https://github.com/Carolinedanslesnuages/PACE/blob/main/PRIVACY_POLICY.md",
      "termsOfServiceUrl": "https://github.com/Carolinedanslesnuages/PACE/blob/main/TERMS_OF_SERVICE.md"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "add_expense": {
              "foregroundImage": "./assets/icon.png"
            }
          },
          "iosIcons": {
            "add_expense": "plus.circle.fill"
          }
        }
      ],
      [
        "react-native-widget-extension",
        {
          "frequentUpdates": true,
          "widgets": [
            {
              "name": "BudgetWidget",
              "displayName": "PACE Budget",
              "description": "See your daily budget at a glance",
              "platforms": ["ios", "android"]
            }
          ]
        }
      ]
    ]
  }
}
